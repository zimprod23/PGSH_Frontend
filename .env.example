# Copy this file to .env and fill in the values

# Keycloak (Aspire always binds Keycloak to 8082 in dev)
VITE_KEYCLOAK_URL=http://localhost:8082
VITE_KEYCLOAK_REALM=pgsh
VITE_KEYCLOAK_CLIENT_ID=pgsh-frontend

# Vite dev server port
VITE_PORT=5173

# Set to "true" to show the maintenance page instead of the app
VITE_MAINTENANCE_MODE=false

# NOTE: The API base URL is NOT needed here.
# Vite proxies all /api requests to the backend automatically.
# When running via Aspire the proxy target is injected as:
#   process.env["services__pgsh-api__https__0"]
# When running standalone set that env var to http://localhost:5199

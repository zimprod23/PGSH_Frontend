# Keycloak — these are the real values, hardcoded because Aspire always runs Keycloak on 8082
VITE_KEYCLOAK_URL=http://localhost:8082
VITE_KEYCLOAK_REALM=pgsh
VITE_KEYCLOAK_CLIENT_ID=pgsh-frontend

# Vite dev server port (must match the port registered in AppHost)
VITE_PORT=5173

# Set to "true" to show the maintenance page
VITE_MAINTENANCE_MODE=false
